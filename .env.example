# Copie para .env e ajuste. O .env nunca vai para o repositório.

# Banco usado pela aplicação. Para desenvolvimento, o PostgreSQL local do docker-compose.
# Para o servidor do grupo, use a URL fornecida pelo responsável pela integração (só no .env).
DATABASE_URL="postgresql://vitalis:vitalis@localhost:5432/vitalis"

# Banco exclusivo dos testes. É apagado a cada execução de "npm test".
# Precisa ser local (localhost) ou ter nome terminado em _teste.
DATABASE_URL_TESTE="postgresql://vitalis:vitalis@localhost:5432/vitalis_teste"

# Chave de assinatura dos tokens JWT. Use um valor longo e aleatório fora do ambiente local.
JWT_SEGREDO="troque-esta-chave-em-producao"

# Porta da API (opcional, padrão 3333)
# PORTA=3333
